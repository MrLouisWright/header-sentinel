{
  "name": "header-sentinel",
  "version": "1.1.0",
  "description": "CI-friendly CLI and API that fails builds when deployed URLs are missing or misconfigure HTTP security headers (HSTS, CSP, COOP, cookies...) with specific fixes. Mozilla Observatory-style A–F grades, JSON & SARIF output.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "header-sentinel": "bin/header-sentinel.js"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "security",
    "headers",
    "security-headers",
    "csp",
    "hsts",
    "content-security-policy",
    "mozilla-observatory",
    "ci",
    "cli",
    "github-action",
    "sarif",
    "owasp",
    "devsecops",
    "http"
  ],
  "author": "Louis Wright (https://github.com/MrLouisWright)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLouisWright/header-sentinel.git"
  },
  "bugs": {
    "url": "https://github.com/MrLouisWright/header-sentinel/issues"
  },
  "homepage": "https://github.com/MrLouisWright/header-sentinel#readme"
}
